# Copie para `.env` na raiz do repositório ao usar `docker compose` (não commite `.env`).
# Valores de exemplo — substitua por segredos fortes.

JWT_SECRET=replace-with-long-random-string
SERVICE_AUTH_SECRET=replace-with-long-random-string-shared-by-orders-and-payment
MERCADOPAGO_WEBHOOK_SECRET=replace-with-mercadopago-webhook-secret
# Mesmo valor em auth e users (provisionamento HTTP interno)
INTERNAL_API_SECRET=replace-with-long-random-internal-secret

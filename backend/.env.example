# Opcional: ficheiro backend/.env (na pasta backend/) — lido pelo seed product e outras ferramentas.
# INVENTORY_SERVICE_URL=http://localhost:3002
# SERVICE_AUTH_SECRET=igual ao inventory / Compose
# MONGODB_URI=mongodb://localhost:27017/dl_product_svc
# SEED_INVENTORY_QUANTITY=50
# SEED_INVENTORY_MAX=100
# SEED_INVENTORY_MIN=10
# SEED_INVENTORY_LOW_STOCK_THRESHOLD=5
# SEED_INVENTORY_CREATED_BY=seed@dl-orders.local

# ============================
# Orders Service (port 3001)
# ============================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dl_orders_svc
# RABBITMQ_URL=amqp://admin:admin@localhost:5672
# QUEUE_NAME=orders_queue
# PORT=3001
# MONGODB_URI=mongodb://localhost:27018/dl_orders_audit
# PRODUCT_SERVICE_URL=http://localhost:3003
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=igual ao auth
# SERVICE_AUTH_SECRET=igual ao payment

# ============================
# Inventory Service (port 3002)
# ============================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dl_inventory_svc
# RABBITMQ_URL=amqp://admin:admin@localhost:5672
# QUEUE_NAME=inventory_queue
# PORT=3002
# MONGODB_URI=...
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=igual ao auth
# SERVICE_AUTH_SECRET=mesmo valor no Next BFF e seed product (x-service-auth)

# ============================
# Next.js frontend (BFF, port 3000) — usar frontend/.env.example
# ============================
# INVENTORY_SERVICE_URL=http://localhost:3002
# SERVICE_AUTH_SECRET=igual ao inventory

# ============================
# Product Service (port 3003)
# ============================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/dl_product_svc
# PORT=3003

# ============================
# Notification Service (no HTTP)
# ============================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5435/dl_notification_svc
# RABBITMQ_URL=amqp://admin:admin@localhost:5672
# QUEUE_NAME=notification_queue
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Notifications <onboarding@resend.dev>

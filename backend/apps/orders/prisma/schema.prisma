generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/orders-client"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                 String      @id @default(uuid())
  sequenceId         Int         @unique @default(autoincrement()) @map("sequence_id")
  description        String
  status             OrderStatus @default(PENDING)
  productId          String      @map("product_id")
  quantity           Int
  recipient          String
  productName        String   @default("") @map("product_name")
  productDescription String   @default("") @map("product_description")
  idempotencyKey     String    @unique @map("idempotency_key")
  unitPrice          Float    @default(0) @map("unit_price")
  totalPrice         Float    @default(0) @map("total_price")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/orders-client"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                 String      @id @default(uuid())
  sequenceId         Int         @unique @default(autoincrement()) @map("sequence_id")
  description        String      @db.VarChar(500)
  status             OrderStatus @default(PENDING)
  productId          String      @db.VarChar(36) @map("product_id")
  quantity           Int
  recipient          String      @db.VarChar(254)
  productName        String      @db.VarChar(200) @default("") @map("product_name")
  productDescription String      @db.VarChar(2000) @default("") @map("product_description")
  idempotencyKey     String      @db.VarChar(36) @unique @map("idempotency_key")
  unitPrice          Float    @default(0) @map("unit_price")
  totalPrice         Float    @default(0) @map("total_price")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

DATABASE_URL=postgresql://postgres:postgres@localhost:5438/dl_payment_svc
RABBITMQ_URL=amqp://admin:admin@localhost:5672
QUEUE_NAME=payment_queue
PORT=3007
ORDERS_SERVICE_URL=http://localhost:3001
MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
# Required for POST /payments/webhook (endpoint returns 503 if unset)
MERCADOPAGO_WEBHOOK_SECRET=xxx
# Same value as orders SERVICE_AUTH_SECRET (header x-service-auth on order fetch)
SERVICE_AUTH_SECRET=change-me-shared-with-orders

# Required for GET /payments/order/:orderId (JWT). Same value as auth service.
JWT_SECRET=change-me-same-as-auth

# Optional back URLs for Mercado Pago checkout
# MERCADOPAGO_BACK_URL_SUCCESS=
# MERCADOPAGO_BACK_URL_FAILURE=
# MERCADOPAGO_BACK_URL_PENDING=

MONGODB_URI=mongodb://localhost:27021/dl_payment_audit

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/notification-client"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id                 String             @id @default(uuid())
  sequenceId         Int                @unique @default(autoincrement()) @map("sequence_id")
  title              String             @db.VarChar(200)
  content            String             @db.VarChar(5000)
  type               NotificationType   @default(EMAIL)
  status             NotificationStatus @default(PENDING)
  sourceEventId      String             @db.VarChar(100) @map("source_event_id")
  recipientEmail     String             @db.VarChar(254) @map("recipient_email")
  userId             String             @db.VarChar(36) @map("user_id")
  productName        String             @db.VarChar(200) @map("product_name")
  productDescription String             @db.VarChar(2000) @map("product_description")
  totalPrice         Float              @map("total_price")
  quantity           Int
  sentAt             DateTime?          @map("sent_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("notifications")
}

enum NotificationType {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model CartAbandonmentSchedule {
  sessionKey     String   @id @map("session_key") @db.VarChar(64)
  email          String   @db.VarChar(254)
  resumeUrl      String   @map("resume_url") @db.VarChar(2000)
  pendingUntil   DateTime @map("pending_until")
  summaryLines   String   @map("summary_lines") @db.VarChar(2000)
  sent           Boolean  @default(false)
  failCount      Int      @default(0) @map("fail_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("cart_abandonment_schedules")
}

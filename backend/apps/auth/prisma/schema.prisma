generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/auth-client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  emailEncrypted   String   @map("email_encrypted")
  emailLookupHash  String   @unique @map("email_lookup_hash")
  passwordHash     String   @map("password_hash")
  name             String?
  emailVerified    Boolean  @default(false) @map("email_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  otpCodes         OtpCode[]
  authLogs         AuthLogs?
  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  code      String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model AuthLogs {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAttempts Int    @default(0) @map("login_attempts")
  lastLoginAttempt DateTime @map("last_login_attempt")
  lastLoginAttemptIp String? @map("last_login_attempt_ip")
  lastLoginAttemptSuccess Boolean @default(false) @map("last_login_attempt_success")
  lockedUntil DateTime? @map("locked_until")
  createdAt DateTime @default(now()) @map("created_at")


  @@map("auth_logs")
}

